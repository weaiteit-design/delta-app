# ============================================
# Delta App — Environment Variables
# Copy this file to .env.local and fill in your keys.
# NEVER commit .env.local to git.
# ============================================

# Google Gemini API (required — powers lessons, chat, delta-fication)
# Get key: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# YouTube Data API v3 (optional — powers video sources in lessons)
# Get key: https://console.cloud.google.com → Enable "YouTube Data API v3"
VITE_YOUTUBE_API_KEY=

# NewsAPI.org (optional — general AI news feed)
# Get key: https://newsapi.org/register
VITE_NEWS_API_KEY=

# NewsData.io (optional — secondary news feed)
# Get key: https://newsdata.io/register
VITE_NEWSDATA_API_KEY=

# Supabase (optional — enables cloud auth + sync; app works in local-only mode without these)
# Get from: https://supabase.com → your project → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ============================================
# For React Native / Expo builds, replace VITE_ prefix with EXPO_PUBLIC_
# e.g. EXPO_PUBLIC_GEMINI_API_KEY=
# ============================================
