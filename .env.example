# ============================================
# Delta App — Environment Variables
# Copy this file to .env.local and fill in your keys.
# NEVER commit .env.local to git.
# All keys have free tiers. The app works without them but with fewer sources.
# ============================================

# Google Gemini API (required — powers lessons, chat, delta-fication)
# Get key: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# NewsAPI (40 articles/fetch) — https://newsapi.org/register
VITE_NEWS_API_KEY=

# The Guardian (AI news) — https://open-platform.theguardian.com/access/
VITE_GUARDIAN_API_KEY=

# YouTube Data API v3 (AI tutorials) — https://console.cloud.google.com/apis/credentials
VITE_YOUTUBE_API_KEY=

# NewsData.io (global AI news) — https://newsdata.io/register
VITE_NEWSDATA_API_KEY=

# Supabase (optional — enables cloud auth + sync; app works in local-only mode without these)
# Get from: https://supabase.com → your project → Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ============================================
# For React Native / Expo builds, replace VITE_ prefix with EXPO_PUBLIC_
# e.g. EXPO_PUBLIC_GEMINI_API_KEY=
# ============================================
